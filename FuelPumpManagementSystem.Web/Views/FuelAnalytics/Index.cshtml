@model FuelPumpManagementSystem.Web.Models.FuelAnalyticsViewModel
@{
    ViewData["Title"] = "Fuel Sales Analytics";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fuel Analytics Dashboard</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Fuel Analytics CSS -->
    <link rel="stylesheet" href="~/css/fuel-analytics.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/fuel-analytics-compact.css" asp-append-version="true">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <div class="dashboard-container">
        <!-- Header -->
        <div class="dashboard-header">
            <h1 class="dashboard-title">
                <i class="fas fa-gas-pump"></i> Fuel Analytics
            </h1>
            <p class="dashboard-subtitle">Real-time fuel sales monitoring and insights</p>
        </div>

        <!-- Export Buttons -->
       @*  <div class="export-section">
            <button class="export-btn pdf" onclick="exportToPDF()" title="Export PDF">
                <i class="fas fa-file-pdf fa-lg"></i>
                <span>Export to PDF</span>
            </button>
            <button class="export-btn csv" onclick="exportToCSV()" title="Export CSV">
                <i class="fas fa-file-csv fa-lg"></i>
                <span>Export to CSV</span>
            </button>
        </div> *@

        <!-- Filter Section -->
        <div class="filter-section">
            <!-- Apply/Reset Buttons -->
            <div class="row mb-3">
                <div class="col-12 text-center">
                    <button type="button" class="btn btn-primary btn-lg me-3" onclick="applyFilters()">
                        <i class="fas fa-search"></i> Apply Filters
                    </button>
                    <button type="button" class="btn btn-secondary btn-lg" onclick="resetFilters()">
                        <i class="fas fa-undo"></i> Reset
                    </button>
                </div>
            </div>
            
            <div class="row">
                <!-- Time Period Filter -->
                <div class="col-lg-4 col-md-6 mb-2">
                    <div class="filter-card">
                        <div class="filter-title">
                            <i class="fas fa-calendar-alt"></i>
                            Time Period
                        </div>
                        <select id="periodSelect" class="form-select form-select-lg mb-3">
                            <option value="">Select Period...</option>
                            <option value="today">Today</option>
                            <option value="yesterday">Yesterday</option>
                            <option value="last7days">Last 7 Days</option>
                            <option value="last30days">Last 30 Days</option>
                            <option value="thisweek">This Week</option>
                            <option value="thismonth">This Month</option>
                            <option value="lastmonth">Last Month</option>
                            <option value="thisyear">This Year</option>
                            <option value="lastyear">Last Year</option>
                            <option value="custom">Custom Range</option>
                        </select>
                        
                        <div id="customDateRange" style="display: none;">
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label">From Date</label>
                                    <input type="date" id="fromDate" class="form-control">
                                </div>
                                <div class="col-6">
                                    <label class="form-label">To Date</label>
                                    <input type="date" id="toDate" class="form-control">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- View Type Filter -->
                <div class="col-lg-4 col-md-6 mb-2">
                    <div class="filter-card">
                        <div class="filter-title">
                            <i class="fas fa-eye"></i>
                            View Type
                        </div>
                        <select id="viewTypeSelect" class="form-select form-select-lg">
                            <option value="whole">Whole Pump View</option>
                            <option value="dispenser">Per Dispenser View</option>
                            <option value="category">Per Fuel Category View</option>
                        </select>
                    </div>
                </div>

                <!-- Dispenser Filter -->
                <div class="col-lg-4 col-md-6 mb-2">
                    <div class="filter-card">
                        <div class="filter-title">
                            <i class="fas fa-oil-can"></i>
                            Dispenser Filter
                        </div>
                        <select id="dispenserSelect" class="form-select form-select-lg">
                            <option value="ALL" selected>All Dispensers</option>
                            @if (Model?.Transactions != null)
                            {
                                foreach (var d in Model.Transactions.Select(x => x.DispenserId).Distinct().OrderBy(x => x))
                                {
                                    <option value="@d">Dispenser @d</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <!-- Fuel Type Filter -->
                <div class="col-lg-4 col-md-6 mb-2">
                    <div class="filter-card">
                        <div class="filter-title">
                            <i class="fas fa-gas-pump"></i>
                            Fuel Type
                        </div>
                        <select id="fuelTypeSelect" class="form-select form-select-lg">
                            <option value="ALL" selected>All Fuel Types</option>
                            @if (Model?.Products != null)
                            {
                                foreach (var p in Model.Products)
                                {
                                    <option value="@p.ProductId">@p.ProductName</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <!-- Export Buttons Section -->
                <div class="col-lg-4 col-md-6 mb-2">
                    <div class="filter-card">
                        <div class="filter-title">
                            <i class="fas fa-download"></i>
                            Export Options
                        </div>
                        <div class="export-buttons-inline">
                            <button class="btn btn-success me-2" onclick="exportToCSV()">
                                <i class="fas fa-file-excel"></i> Export to Excel
                            </button>
                            <button class="btn btn-danger" onclick="exportToPDF()">
                                <i class="fas fa-file-pdf"></i> Export to PDF
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Analytics Content -->
        <div id="analyticsContent">
            <div class="loading-spinner">
                <div class="spinner"></div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        $(document).ready(function() {
            setDefaultDates();
            applyFilters();
        });

        function setDefaultDates() {
            var today = new Date();
            
            $('#toDate').val(formatDateForServer(today));
            $('#fromDate').val(formatDateForServer(today));
            $('#periodSelect').val('today');
        }

        function formatDateForServer(date) {
            var year = date.getFullYear();
            var month = String(date.getMonth() + 1).padStart(2, '0');
            var day = String(date.getDate()).padStart(2, '0');
            return year + '-' + month + '-' + day;
        }

        function getPresetDates(period) {
            var today = new Date();
            var from, to;
            
            switch(period) {
                case 'today':
                    from = to = today;
                    break;
                case 'yesterday':
                    from = to = new Date(today.getTime() - 24 * 60 * 60 * 1000);
                    break;
                case 'last7days':
                    from = new Date(today.getTime() - 6 * 24 * 60 * 60 * 1000);
                    to = today;
                    break;
                case 'last30days':
                    from = new Date(today.getTime() - 29 * 24 * 60 * 60 * 1000);
                    to = today;
                    break;
                case 'thisweek':
                    var dayOfWeek = today.getDay();
                    var diff = today.getDate() - dayOfWeek + (dayOfWeek === 0 ? -6 : 1);
                    from = new Date(today.setDate(diff));
                    to = new Date();
                    break;
                case 'thismonth':
                    from = new Date(today.getFullYear(), today.getMonth(), 1);
                    to = today;
                    break;
                case 'lastmonth':
                    from = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                    to = new Date(today.getFullYear(), today.getMonth(), 0);
                    break;
                case 'thisyear':
                    from = new Date(today.getFullYear(), 0, 1);
                    to = today;
                    break;
                case 'lastyear':
                    from = new Date(today.getFullYear() - 1, 0, 1);
                    to = new Date(today.getFullYear() - 1, 11, 31);
                    break;
                case 'last3months':
                    from = new Date(today.getFullYear(), today.getMonth() - 2, 1);
                    to = today;
                    break;
                case 'last6months':
                    from = new Date(today.getFullYear(), today.getMonth() - 5, 1);
                    to = today;
                    break;
            }
            
            return {
                from: formatDateForServer(from),
                to: formatDateForServer(to)
            };
        }

        $('#periodSelect').change(function() {
            var period = $(this).val();
            
            if (period === 'custom') {
                $('#customDateRange').show();
                return;
            } else {
                $('#customDateRange').hide();
            }
            
            if (period) {
                var dates = getPresetDates(period);
                $('#fromDate').val(dates.from);
                $('#toDate').val(dates.to);
                applyFilters();
            }
        });

        // View Type dropdown change handler
        $('#viewTypeSelect').change(function() {
            applyFilters();
        });

        function applyFilters() {
            var filters = collectFilterData();
            
            $.ajax({
                url: '/FuelAnalytics/UpdateAnalytics',
                type: 'POST',
                data: filters,
                beforeSend: function() {
                    $('#analyticsContent').html('<div class="loading-spinner"><div class="spinner"></div></div>');
                },
                success: function(data) {
                    $('#analyticsContent').html(data).addClass('fade-in');
                    initializeCharts();
                },
                error: function(xhr, status, error) {
                    $('#analyticsContent').html('<div class="alert alert-danger">Error loading analytics data: ' + error + '</div>');
                }
            });
        }

        function collectFilterData() {
            return {
                FromDate: $('#fromDate').val(),
                ToDate: $('#toDate').val(),
                DispenserIds: $('#dispenserSelect').val() || [],
                ProductIds: $('#fuelTypeSelect').val() || [],
                ViewType: $('#viewTypeSelect').val(),
                FuelCategory: $('#categorySelect').val(),
                CombineCategories: $('#combineCategories').is(':checked')
            };
        }

        function resetFilters() {
            $('#viewTypeSelect').val('whole');
            $('#dispenserSelect').val(['ALL']);
            $('#categorySelect').val('all');
            $('#fuelTypeSelect').val(['ALL']);
            $('#combineCategories').prop('checked', true);
            $('#periodSelect').val('today');
            $('#customDateRange').hide();
            setDefaultDates();
            applyFilters();
        }

        function getCurrentFilters() {
            // Get current filter values directly from form elements
            var fromDate = $('#fromDate').val();
            var toDate = $('#toDate').val();
            var dispenserId = $('#dispenserSelect').val();
            var productId = $('#fuelTypeSelect').val();
            var viewType = $('#viewTypeSelect').val();
            
            // Handle period selection
            var period = $('#periodSelect').val();
            if (period && period !== 'custom') {
                var dates = getPresetDates(period);
                fromDate = dates.from;
                toDate = dates.to;
            }
            
            return {
                fromDate: fromDate,
                toDate: toDate,
                dispenserId: dispenserId,
                productId: productId,
                viewType: viewType
            };
        }

        function exportToCSV() {
            // Get current filters
            var filters = getCurrentFilters();
            var params = new URLSearchParams();
            
            // Build URL parameters
            if (filters.fromDate) params.append('fromDate', filters.fromDate);
            if (filters.toDate) params.append('toDate', filters.toDate);
            if (filters.dispenserId && filters.dispenserId !== 'ALL') params.append('dispenserIds', filters.dispenserId);
            if (filters.productId && filters.productId !== 'ALL') params.append('productIds', filters.productId);
            if (filters.viewType) params.append('viewType', filters.viewType);
            
            console.log('Export URL:', '/FuelAnalytics/ExportToCSV?' + params.toString());
            console.log('Current Filters:', filters);
            
            window.open('/FuelAnalytics/ExportToCSV?' + params.toString(), '_blank');
        }

        function exportToPDF() {
            // Get current filters
            var filters = getCurrentFilters();
            var params = new URLSearchParams();
            
            // Build URL parameters
            if (filters.fromDate) params.append('fromDate', filters.fromDate);
            if (filters.toDate) params.append('toDate', filters.toDate);
            if (filters.dispenserId && filters.dispenserId !== 'ALL') params.append('dispenserIds', filters.dispenserId);
            if (filters.productId && filters.productId !== 'ALL') params.append('productIds', filters.productId);
            if (filters.viewType) params.append('viewType', filters.viewType);
            
            console.log('Export URL:', '/FuelAnalytics/ExportToPDF?' + params.toString());
            console.log('Current Filters:', filters);
            
            window.open('/FuelAnalytics/ExportToPDF?' + params.toString(), '_blank');
        }

        function initializeCharts() {
            console.log('Charts initialized');
        }
    </script>
</body>
</html>
