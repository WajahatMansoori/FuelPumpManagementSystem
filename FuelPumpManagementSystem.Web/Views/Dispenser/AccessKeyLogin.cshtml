@{
    ViewData["Title"] = "Access Key Required";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fuel Pump Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/accessKeyLogin.css" asp-append-version="true" />
</head>
<body>
    <div class="animated-bg"></div>
    
    <div class="particles">
        <div class="particle" style="width: 10px; height: 10px; left: 10%; top: 20%; animation-delay: 0s;"></div>
        <div class="particle" style="width: 15px; height: 15px; left: 80%; top: 30%; animation-delay: 2s;"></div>
        <div class="particle" style="width: 8px; height: 8px; left: 50%; top: 60%; animation-delay: 4s;"></div>
        <div class="particle" style="width: 12px; height: 12px; left: 20%; top: 80%; animation-delay: 6s;"></div>
        <div class="particle" style="width: 10px; height: 10px; left: 90%; top: 70%; animation-delay: 8s;"></div>
    </div>

    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="login-icon">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h1>Access Key Required</h1>
                <p>Enter your access key to manage dispensers</p>
            </div>
            <div class="login-body">
                <div id="alertBox" class="alert-custom">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span id="alertMessage"></span>
                </div>

                <form id="accessKeyForm">
                    <div class="mb-3">
                        <label for="accessKey" class="form-label">Access Key</label>
                        <div class="access-key-input">
                            <input type="password" 
                                   class="form-control" 
                                   id="accessKey" 
                                   name="accessKey" 
                                   placeholder="Enter your access key"
                                   autocomplete="off"
                                   required>
                            <i class="bi bi-key-fill input-icon"></i>
                        </div>
                    </div>

                    <button type="submit" class="btn-login" id="loginBtn">
                        <span class="btn-text">
                            <i class="bi bi-unlock-fill"></i> Unlock Access
                        </span>
                        <span class="spinner">
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            Verifying...
                        </span>
                    </button>
                </form>

                <div class="back-link">
                    <a href="/">
                        <i class="bi bi-arrow-left"></i> Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            const form = $('#accessKeyForm');
            const accessKeyInput = $('#accessKey');
            const loginBtn = $('#loginBtn');
            const alertBox = $('#alertBox');
            const alertMessage = $('#alertMessage');

            // Focus on input
            accessKeyInput.focus();

            form.on('submit', function(e) {
                e.preventDefault();
                
                const accessKey = accessKeyInput.val().trim();
                
                if (!accessKey) {
                    showAlert('Please enter your access key', 'error');
                    return;
                }

                // Show loading state
                loginBtn.addClass('loading').prop('disabled', true);
                hideAlert();

                // Validate access key
                $.ajax({
                    url: '/Dispenser/ValidateAccessKey',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ accessKey: accessKey }),
                    success: function(response) {
                        if (response.success) {
                            showAlert(response.message, 'success');
                            setTimeout(function() {
                                window.location.href = '/Dispenser/Index';
                            }, 1000);
                        } else {
                            showAlert(response.message, 'error');
                            loginBtn.removeClass('loading').prop('disabled', false);
                            accessKeyInput.val('').focus();
                        }
                    },
                    error: function() {
                        showAlert('An error occurred. Please try again.', 'error');
                        loginBtn.removeClass('loading').prop('disabled', false);
                    }
                });
            });

            function showAlert(message, type) {
                alertMessage.text(message);
                alertBox.removeClass('alert-error alert-success');
                alertBox.addClass(type === 'error' ? 'alert-error' : 'alert-success');
                alertBox.addClass('show');
            }

            function hideAlert() {
                alertBox.removeClass('show');
            }
        });
    </script>
</body>
</html>
