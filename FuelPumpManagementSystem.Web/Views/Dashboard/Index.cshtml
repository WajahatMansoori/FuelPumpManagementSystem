
@{
    ViewData["Title"] = "Dashboard";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="~/css/dashboard.css" rel="stylesheet" />
	<title>Fuel Station Dashboard</title>
</head>


<body>
    <!-- HEADER -->
    <div class="header-card">
      <div class="station-info">
        <div class="station-logo">
          <img src="./assets/programmer.png" />
        </div>
        <div class="station-details">
          <h1>RES FUELING STATION</h1>
          <div class="station-meta">
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </span>
            P80, Gulshan e Shamim, Karachi
          </div>
          <div class="station-meta">
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                />
              </svg>
            </span>
            +92-330-8530186
          </div>
        </div>
      </div>
      <div class="theme-toggle-container">
        <span class="theme-label" id="themeLabel">Dark Mode</span>
        <button class="theme-toggle">
          <svg
            class="sun-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
          >
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
          </svg>
          <svg
            class="moon-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            style="display: none"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          Light
        </button>
      </div>
    </div>

    <!-- DASHBOARD -->
    <div class="dashboard-content">
      <!-- STATS -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon petrol-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
            </svg>
          </div>
          <div class="stat-content">
            <small>Today Sales Petrol</small>
            <p class="stat-value" id="petrolSales">0 L</p>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon hioctane-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
            </svg>
          </div>
          <div class="stat-content">
            <small>Today Sales Hi-Octane</small>
            <p class="stat-value" id="hioctaneSales">0 L</p>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon diesel-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
            </svg>
          </div>
          <div class="stat-content">
            <small>Today Sales Diesel</small>
            <p class="stat-value" id="dieselSales">0 L</p>
          </div>
        </div>
      </div>

      <!-- Dispensers Grid -->
      <div class="dispensers-grid" id="dispensersGrid">
        <div class="dispenser-card" data-dispenser-id="dispenserId">
