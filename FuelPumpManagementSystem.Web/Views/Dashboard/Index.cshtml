@model FuelPumpManagementSystem.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";  
}

@section Styles {
    <link href="~/css/dashboard.css" rel="stylesheet"  asp-append-version="true" />
}


 
    <!-- HEADER -->
    <div class="header-card">
      <button class="mobile-menu-btn" id="mobileMenuBtn">
        <i class="bi bi-list"></i>
      </button>
	<div class="station-info">
        <div class="station-logo">
            <img src="@(!string.IsNullOrEmpty(Model.SiteDetail?.SiteLogo) ? Url.Content(Model.SiteDetail.SiteLogo) : Url.Content("~/uploads/defaultlogo.png"))" />
        </div>
        <div class="station-details">
          <h1>@(!string.IsNullOrEmpty(Model.SiteDetail?.SiteName) ? Model.SiteDetail.SiteName : "RES FUELING STATION")</h1>
          <div class="station-meta">
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </span>
            @(!string.IsNullOrEmpty(Model.SiteDetail?.SiteAddress) ? Model.SiteDetail.SiteAddress : "P80, Gulshan e Shamim, Karachi")
          </div>
          <div class="station-meta">
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                />
              </svg>
            </span>
            @(!string.IsNullOrEmpty(Model.SiteDetail?.SitePhone) ? Model.SiteDetail.SitePhone : "+92-330-8530186")
          </div>
        </div>
      </div>
      <div class="theme-toggle-container">
        <div class="datetime-display" id="currentDateTime"></div>
        <!-- THEME BUTTONS -->
        <!-- <span class="theme-label" id="themeLabel">Dark Mode</span> -->
