@model FuelPumpManagementSystem.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";  
}

@section Styles {
    <link href="~/css/dashboard.css" rel="stylesheet"  asp-append-version="true" />
}


 
    <!-- HEADER -->
    <div class="header-card">
      <button class="mobile-menu-btn" id="mobileMenuBtn">
        <i class="bi bi-list"></i>
      </button>
	<div class="station-info">
        <div class="station-logo">
            <img src="@(!string.IsNullOrEmpty(Model.SiteDetail?.SiteLogo) ? Url.Content(Model.SiteDetail.SiteLogo) : Url.Content("~/uploads/defaultlogo.png"))" />
        </div>
        <div class="station-details">
          <h1>@(!string.IsNullOrEmpty(Model.SiteDetail?.SiteName) ? Model.SiteDetail.SiteName : "RES FUELING STATION")</h1>
          <div class="station-meta">
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </span>
            @(!string.IsNullOrEmpty(Model.SiteDetail?.SiteAddress) ? Model.SiteDetail.SiteAddress : "P80, Gulshan e Shamim, Karachi")
          </div>
          <div class="station-meta">
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                />
              </svg>
            </span>
            @(!string.IsNullOrEmpty(Model.SiteDetail?.SitePhone) ? Model.SiteDetail.SitePhone : "+92-330-8530186")
          </div>
        </div>
      </div>
      <div class="theme-toggle-container">
        <div class="datetime-display" id="currentDateTime"></div>
        <button class="theme-toggle-btn" id="themeToggleBtn" onclick="toggleTheme()">
          <svg class="theme-icon sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
          </svg>
          <svg class="theme-icon moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="display: none;">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          <span class="theme-text">Light Mode</span>
        </button>
      </div>
    </div>

    <!-- DASHBOARD -->
    <div class="dashboard-content">
      <!-- STATS -->
      <div class="stats-grid" id="statsCardsContent">
        @await Html.PartialAsync("_StatsCards", Model.Stats)
      </div>

      <!-- Dispensers Grid -->
      @await Html.PartialAsync("_DispenserGrid", Model.Dispensers)
    </div>
 

<!-- Lock Access Key Modal -->
<div id="lockAccessKeyModal" class="lock-modal" style="display: none;">
    <div class="lock-modal-overlay" onclick="closeLockAccessKeyModal()"></div>
    <div class="lock-modal-content">
        <div class="lock-modal-header">
            <h3>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width: 24px; height: 24px; display: inline-block; vertical-align: middle; margin-right: 8px;">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                Access Key Required
            </h3>
            <button class="lock-modal-close" onclick="closeLockAccessKeyModal()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <div class="lock-modal-body">
            <p class="lock-modal-description">Please enter your access key to lock/unlock the dispenser</p>
            <div class="lock-form-group">
                <label for="lockAccessKey">Access Key</label>
                <input type="password" id="lockAccessKey" class="lock-form-control" placeholder="Enter access key" />
            </div>
            <div id="lockAccessKeyError" class="lock-error-message" style="display: none;"></div>
        </div>
        <div class="lock-modal-footer">
            <button class="lock-btn-cancel" onclick="closeLockAccessKeyModal()">Cancel</button>
            <button class="lock-btn-submit" onclick="submitLockAccessKey()">Verify & Proceed</button>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
    <script src="/js/dashboard.js"></script>
}

