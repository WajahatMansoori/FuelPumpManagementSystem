            <div class="dispenser-title">
              <span class="status-dot"></span>
              <span class="dispenser-number">DISPENSER 1</span>
            </div>
            <div class="dispenser-actions">
              <span class="status-badge online">ONLINE</span>

              <button class="lock-btn unlocked">
                <svg
                  class="lock-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                >
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                  <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>

                <svg
                  class="unlock-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                >
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                  <path d="M7 11V7a5 5 0 0 1 9.9-1" />
                </svg>
              </button>
            </div>
          </div>

          <div class="nozzles-container">
            <!-- Nozzle 1 -->
            <div class="nozzle-card">
              <div class="nozzle-header">
                <span class="nozzle-label">NOZZLE 1</span>
                <span class="nozzle-status" data-nozzle="1">IN</span>
