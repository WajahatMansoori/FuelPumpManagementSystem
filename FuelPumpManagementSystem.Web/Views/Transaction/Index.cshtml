@model FuelPumpManagementSystem.Web.Models.TransactionIndexViewModel
@using FuelPumpManagementSystem.Application.DTOs.Response
@using Microsoft.AspNetCore.Mvc.Rendering

<div class="card shadow-sm">

    <!-- HEADER + FILTER FORM -->
    <div class="card-header bg-dark text-white">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Transactions</h5>
        </div>

        <form method="get" class="row g-2">
            <div class="col-md-2">
                <input type="date" name="fromDate" class="form-control form-control-sm"
                       value="@ViewData["FromDate"]" />
            </div>

            <div class="col-md-2">
                <input type="date" name="toDate" class="form-control form-control-sm"
                       value="@ViewData["ToDate"]" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Dispenser</label>
                @{
                    var selectedDispensers = ViewData["DispenserIds"] as string[];
                    var allTransactions = ViewData["AllTransactions"] as List<FuelPumpManagementSystem.Application.DTOs.Response.TransactionResponseDTO>;

                    bool isAllDispensersSelected =
                        selectedDispensers == null ||
                        selectedDispensers.Length == 0 ||
                        selectedDispensers.Contains("ALL");
                }

                <select name="dispenserIds" class="form-select form-select-sm" multiple>
                    <option value="ALL" selected="@isAllDispensersSelected">ALL</option>
                    @if (allTransactions != null)
                    {
                        foreach (var d in allTransactions.Select(x => x.DispenserId).Distinct().OrderBy(x => x))
                        {
                            var isSelected = selectedDispensers != null &&
                                             selectedDispensers.Contains(d.ToString()) &&
                                             !isAllDispensersSelected;

                            <option value="@d" selected="@isSelected">@d</option>
                        }
                    }
                </select>
                <small class="text-muted">Hold Ctrl/Cmd to select multiple</small>
            </div>

            <div class="col-md-2">
                <label class="form-label">Nozzle</label>
                @{
                    var selectedNozzle = ViewData["NozzleId"] as string;
                    bool isAllNozzlesSelected =
                        string.IsNullOrEmpty(selectedNozzle) || selectedNozzle == "ALL";
                }

                <select name="nozzleId" class="form-select form-select-sm">
                    <option value="ALL" selected="@isAllNozzlesSelected">ALL</option>
                    @if (allTransactions != null)
                    {
                        foreach (var n in allTransactions.Select(x => x.NozzleId).Distinct().OrderBy(x => x))
                        {
                            <option value="@n" selected="@(selectedNozzle == n.ToString())">@n</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Product Type</label>
                @{
                    var selectedProducts = ViewData["ProductIds"] as string[];
                    bool isAllSelected =
                        selectedProducts == null ||
                        selectedProducts.Length == 0 ||
                        selectedProducts.Contains("ALL");
                }

                <select name="productIds" class="form-select form-select-sm" multiple>
                    <option value="ALL" selected="@isAllSelected">ALL</option>
                    @if (Model?.Products != null)
                    {
                        foreach (var p in Model.Products)
                        {
                            var isSelected =
                                selectedProducts != null &&
                                selectedProducts.Contains(p.ProductId.ToString());

                            <option value="@p.ProductId" selected="@isSelected">
                                @p.ProductName
                            </option>
                        }
                    }
                </select>
                <small class="text-muted">Hold Ctrl/Cmd to select multiple</small>
            </div>

            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-sm btn-light">Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-sm btn-secondary">Reset</a>

                <a class="btn btn-sm btn-success"
                   href="@Url.Action("ExportToExcel",
                        new {
                            fromDate = ViewData["FromDate"],
                            toDate = ViewData["ToDate"],
                            dispenserIds = ViewData["DispenserIds"],
                            nozzleId = ViewData["NozzleId"],
                            productIds = ViewData["ProductIds"]
                        })">
                    Export Excel
                </a>

                <a class="btn btn-sm btn-danger"
                   href="@Url.Action("ExportToPdf",
                        new {
                            fromDate = ViewData["FromDate"],
                            toDate = ViewData["ToDate"],
                            dispenserIds = ViewData["DispenserIds"],
                            nozzleId = ViewData["NozzleId"],
                            productIds = ViewData["ProductIds"]
                        })">
                    Export PDF
                </a>
            </div>
        </form>
    </div>

    <!-- TABLE -->
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="transactionTable" class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Transaction ID</th>
                        <th>Date Time</th>
                        <th>Dispenser</th>
                        <th>Nozzle</th>
                        <th>Fuel Type</th>
                        <th>Litres</th>
                        <th>Unit Price</th>
                        <th>Amount</th>
                        <th>Total Liter</th>
                        <th>Total Cash</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Transactions != null && Model.Transactions.Any())
                    {
                        foreach (var t in Model.Transactions)
                        {
                            <tr>
                                <td>@t.TransactionId</td>
                                <td>@t.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@t.DispenserId</td>
                                <td>@t.NozzleId</td>
                                <td>@Model.Products?.FirstOrDefault(p => p.ProductId == t.ProductTypeId)?.ProductName</td>
                                <td>@t.Liter</td>
                                <td>@t.UnitPrice</td>
                                <td>@t.Amount</td>
                                <td>@t.LastTotalLitre</td>
                                <td>@t.LastTotalCash</td>
                                <td>
                                    <button class="btn btn-sm btn-primary"
                                            onclick="printTransaction(@t.TransactionId)">
                                        Print
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted">
                                No data available
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

<!-- JS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<script>
    function printTransaction(id) {
        var row = $('#transactionTable tbody tr').filter(function () {
            return $(this).find('td:first').text().trim() == id;
        });

        if (!row.length) {
            alert('Transaction not found');
            return;
        }

        var tds = row.find('td');

        var receipt =
"==============================\n" +
"RES FUELING STATION\n" +
"Gulshan-e-Shamim, Block-9\n" +
"Yaseenabad, Karachi\n" +
"Tel: +92-330-8530186\n" +
"==============================\n\n" +
"Transaction ID: " + tds.eq(0).text() + "\n" +
"Date Time: " + tds.eq(1).text() + "\n" +
"Dispenser: " + tds.eq(2).text() + "\n" +
"Nozzle: " + tds.eq(3).text() + "\n" +
"Fuel: " + tds.eq(4).text() + "\n" +
"------------------------------\n" +
"Litres: " + tds.eq(5).text() + "\n" +
"Unit Price: " + tds.eq(6).text() + "\n" +
"Amount: " + tds.eq(7).text() + "\n" +
"------------------------------\n" +
"Total Liter: " + tds.eq(8).text() + "\n" +
"Total Cash: " + tds.eq(9).text() + "\n" +
"------------------------------\n" +
"Thank you for your business!\n";

        var w = window.open('', '', 'width=350,height=500');
        w.document.write('<pre>' + receipt + '</pre>');
        w.document.close();
        w.print();
        w.close();
    }

    $(function () {
        $('#transactionTable').DataTable({
            order: [[1, 'desc']],
            pageLength: 25
        });
    });
</script>
