@using FuelPumpManagementSystem.Application.DTOs.Response
@using FuelPumpManagementSystem.Web.Models
@{
    ViewData["Title"] = "Product Price Management";
    var products = ViewBag.Products as List<ProductPriceViewModel>;
    var dispenserStatuses = ViewBag.DispenserStatuses as List<DispenserStatusViewModel>;
    var hasPriceUpdateLogs = ViewBag.HasPriceUpdateLogs as bool? ?? false;
}

@section Styles {
    <link rel="stylesheet" href="~/css/product.css" asp-append-version="true" />
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="page-header-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="page-title mb-1">💰 Product Price Management</h2>
                        <p class="page-subtitle mb-0">Update fuel prices across all dispensers</p>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-change-password" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                            <i class="bi bi-key"></i> Change Password
                        </button>
                        <button type="button" class="btn btn-update-prices" id="updatePricesBtn" disabled>
                            <i class="bi bi-arrow-repeat"></i> Update Selected Prices
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Products Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm product-card">
                <div class="card-header bg-gradient-primary">
                    <h5 class="mb-0 text-white">
                        <i class="bi bi-fuel-pump"></i> Fuel Products
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover product-table mb-0">
                            <thead>
                                <tr>
                                    <th width="50">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="selectAll">
                                        </div>
                                    </th>
                                    <th width="50"></th>
                                    <th>Product Name</th>
                                    <th width="200">Current Price (PKR)</th>
                                    <th width="250">New Price (PKR)</th>
                                    <th width="150">Price Change</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (products != null && products.Any())
                                {
                                    foreach (var product in products)
                                    {
                                        <tr class="product-row" 
                                            data-product-id="@product.ProductId">
                                            <td>
                                                <div class="form-check">
                                                    <input class="form-check-input product-checkbox" 
                                                           type="checkbox" 
                                                           id="product_@product.ProductId"
                                                           data-product-id="@product.ProductId"
                                                           @(!product.IsMapped ? "disabled" : "")>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="product-color-indicator" 
                                                     style="background-color: @product.ProductColorCode;">
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="product-name">@product.ProductName</span>
                                                    @if (!product.IsMapped)
                                                    {
                                                        <span class="badge unmapped-badge" title="Not mapped to any dispenser">
                                                            <i class="bi bi-exclamation-circle"></i> Not Mapped
                                                        </span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div class="current-price-badge">
                                                    <span class="price-value" id="currentPrice_@product.ProductId">
                                                        @(product.CurrentPrice > 0 ? product.CurrentPrice.ToString("N2") : "--")
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="input-group">
                                                    <span class="input-group-text">PKR</span>
                                                    <input type="number" 
                                                           class="form-control new-price-input" 
                                                           id="newPrice_@product.ProductId"
                                                           data-product-id="@product.ProductId"
                                                           data-current-price="@product.CurrentPrice"
                                                           placeholder="Enter new price"
                                                           step="0.01"
                                                           min="0"
                                                           disabled>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="price-change-badge" id="priceChange_@product.ProductId">
                                                    --
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">
                                            <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                                            <p class="mb-0 mt-2">No products available</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Price Update Status Section -->
    @if (hasPriceUpdateLogs)
    {
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm status-card">
                    <div class="card-header bg-gradient-info">
                        <h5 class="mb-0 text-white">
                            <i class="bi bi-activity"></i> Price Update Status
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover status-table mb-0">
                                <thead>
                                    <tr>
                                        <th width="80">Status</th>
                                        <th>Dispenser Name</th>
                                        <th width="200">API Endpoint</th>
                                        <th width="150">Update Status</th>
                                        <th width="200">Last Updated</th>
                                    </tr>
                                </thead>
                                <tbody id="statusTableBody">
                                    @if (dispenserStatuses != null && dispenserStatuses.Any())
                                    {
                                        foreach (var dispenser in dispenserStatuses.Where(d => d.HasUpdateLog))
                                        {
                                            var statusClass = dispenser.IsOnline ? "status-online" : "status-offline";
                                            var statusIcon = dispenser.IsOnline ? "bi-check-circle" : "bi-x-circle";
                                            var updateStatusClass = dispenser.IsErrorOccured ? "bg-danger" : "bg-success";
                                            var updateStatusIcon = dispenser.IsErrorOccured ? "bi-x-circle" : "bi-check-circle";
                                            var updateStatusText = dispenser.IsErrorOccured ? "Failed" : "Updated";
                                            <tr class="dispenser-status-row">
                                                <td>
                                                    <div class="status-indicator @statusClass">
                                                        <i class="bi @statusIcon"></i>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="dispenser-name">@dispenser.DispenserName</span>
                                                </td>
                                                <td>
                                                    <code class="api-endpoint">@dispenser.ApiEndPoint</code>
                                                </td>
                                                <td>
                                                    <span class="badge status-badge @updateStatusClass">
                                                        <i class="bi @updateStatusIcon"></i> @updateStatusText
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (dispenser.LastUpdated.HasValue)
                                                    {
                                                        <span class="text-muted">@dispenser.LastUpdated.Value.ToString("MMM dd, yyyy hh:mm tt")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">--</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Loader Overlay -->
<div class="loader-overlay" id="loaderOverlay">
    <div class="loader-content">
        <div class="loader-spinner"></div>
        <div class="loader-text">Updating Prices...</div>
        <div class="loader-subtext">Please wait while we update prices across all dispensers</div>
    </div>
</div>

<!-- Change Password Modal -->
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content change-password-modal">
            <div class="modal-header">
                <div class="modal-header-content">
                    <div class="modal-icon">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <div>
                        <h5 class="modal-title" id="changePasswordModalLabel">Change Password</h5>
                        <p class="modal-subtitle">Update your access password</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info d-flex align-items-center mb-4">
                    <i class="bi bi-info-circle me-2"></i>
                    <small>Your new password will be used for future access to this page</small>
                </div>

                <div id="passwordAlert" class="alert alert-danger d-none" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <span id="passwordAlertMessage"></span>
                </div>

                <form id="changePasswordForm">
                    <div class="mb-4">
                        <label for="newPassword" class="form-label">
                            <i class="bi bi-key text-primary"></i> New Password
                        </label>
                        <div class="password-input-wrapper">
                            <input type="password" class="form-control password-input" id="newPassword" placeholder="Enter new password" required>
                            <button type="button" class="password-toggle" onclick="togglePasswordVisibility('newPassword', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <div class="invalid-feedback" id="newPasswordError">Please enter a new password</div>
                    </div>

                    <div class="mb-4">
                        <label for="confirmPassword" class="form-label">
                            <i class="bi bi-shield-check text-success"></i> Confirm Password
                        </label>
                        <div class="password-input-wrapper">
                            <input type="password" class="form-control password-input" id="confirmPassword" placeholder="Re-enter new password" required>
                            <button type="button" class="password-toggle" onclick="togglePasswordVisibility('confirmPassword', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <div class="invalid-feedback" id="confirmPasswordError">Please confirm your password</div>
                    </div>

                    <div class="password-strength-indicator mb-3">
                        <div class="strength-bar">
                            <div class="strength-bar-fill" id="strengthBarFill"></div>
                        </div>
                        <small class="strength-text" id="strengthText">Password strength: <span id="strengthLevel">-</span></small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> Cancel
                </button>
                <button type="button" class="btn btn-primary" id="savePasswordBtn">
                    <span class="btn-text">
                        <i class="bi bi-check-circle"></i> Save Password
                    </span>
                    <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container" id="toastContainer"></div>

@section Scripts {
    <script>
        // Inactivity timeout - 2 minutes
        let inactivityTimer;
        const INACTIVITY_TIMEOUT = 2 * 60 * 1000; // 2 minutes in milliseconds

        function resetInactivityTimer() {
            clearTimeout(inactivityTimer);
            inactivityTimer = setTimeout(function() {
                // Clear session and redirect to dashboard
                fetch('/Product/ClearProductAccess', {
                    method: 'POST'
                }).finally(function() {
                    window.location.href = '/';
                });
            }, INACTIVITY_TIMEOUT);
        }

        // Track user activity - using passive listeners for better performance
        document.addEventListener('mousemove', resetInactivityTimer, { passive: true });
        document.addEventListener('mousedown', resetInactivityTimer, { passive: true });
        document.addEventListener('keydown', resetInactivityTimer, { passive: true });
        document.addEventListener('touchstart', resetInactivityTimer, { passive: true });
        document.addEventListener('scroll', resetInactivityTimer, { passive: true });
        document.addEventListener('wheel', resetInactivityTimer, { passive: true });

        // Start the timer when page loads
        resetInactivityTimer();

        // Clear session when user navigates away from Product page
        window.addEventListener('beforeunload', function(e) {
            // Use sendBeacon for reliable async request that completes even if page is unloading
            navigator.sendBeacon('/Product/ClearProductAccess');
        });

        // Also clear session when user clicks on navigation links
        document.addEventListener('click', function(e) {
            const link = e.target.closest('a');
            if (link && link.href && !link.href.includes('/Product')) {
                // User is navigating away from Product section
                fetch('/Product/ClearProductAccess', {
                    method: 'POST',
                    keepalive: true
                });
            }
        });

        // Toast notification system
        function showToast(type, title, message) {
            const toastContainer = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            
            const iconClass = type === 'success' ? 'bi-check-circle-fill' : 'bi-x-circle-fill';
            
            toast.innerHTML = `
                <div class="toast-icon">
                    <i class="bi ${iconClass}"></i>
                </div>
                <div class="toast-content">
                    <div class="toast-title">${title}</div>
                    <div class="toast-message">${message}</div>
                </div>
                <button class="toast-close" onclick="this.parentElement.remove()">
                    <i class="bi bi-x"></i>
                </button>
                <div class="toast-progress"></div>
            `;
            
            toastContainer.appendChild(toast);
            
            // Auto remove after 5 seconds
            setTimeout(() => {
                toast.classList.add('hiding');
                setTimeout(() => toast.remove(), 400);
            }, 5000);
        }

        // Show/Hide loader
        function showLoader() {
            document.getElementById('loaderOverlay').classList.add('show');
        }

        function hideLoader() {
            document.getElementById('loaderOverlay').classList.remove('show');
        }

        document.addEventListener('DOMContentLoaded', function() {
            const selectAllCheckbox = document.getElementById('selectAll');
            const productCheckboxes = document.querySelectorAll('.product-checkbox');
            const updatePricesBtn = document.getElementById('updatePricesBtn');

            // Select All functionality
            selectAllCheckbox?.addEventListener('change', function() {
                productCheckboxes.forEach(checkbox => {
                    checkbox.checked = this.checked;
                    togglePriceInput(checkbox);
                    updateRowSelection(checkbox);
                });
                updateButtonState();
            });

            // Individual checkbox functionality
            productCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    togglePriceInput(this);
                    updateRowSelection(this);
                    updateSelectAllState();
                    updateButtonState();
                });
            });

            // Price input change handler
            document.querySelectorAll('.new-price-input').forEach(input => {
                input.addEventListener('input', function() {
                    calculatePriceChange(this);
                });
            });

            function togglePriceInput(checkbox) {
                const productId = checkbox.dataset.productId;
                const priceInput = document.getElementById(`newPrice_${productId}`);
                
                if (priceInput) {
                    priceInput.disabled = !checkbox.checked;
                    if (!checkbox.checked) {
                        priceInput.value = '';
                        const priceChangeBadge = document.getElementById(`priceChange_${productId}`);
                        if (priceChangeBadge) {
                            priceChangeBadge.textContent = '--';
                            priceChangeBadge.className = 'price-change-badge';
                        }
                    }
                }
            }

            function updateRowSelection(checkbox) {
                const row = checkbox.closest('.product-row');
                if (row) {
                    if (checkbox.checked) {
                        row.classList.add('selected');
                    } else {
                        row.classList.remove('selected');
                    }
                }
            }

            function updateSelectAllState() {
                const allChecked = Array.from(productCheckboxes).every(cb => cb.checked);
                const someChecked = Array.from(productCheckboxes).some(cb => cb.checked);
                
                if (selectAllCheckbox) {
                    selectAllCheckbox.checked = allChecked;
                    selectAllCheckbox.indeterminate = someChecked && !allChecked;
                }
            }

            function updateButtonState() {
                const anyChecked = Array.from(productCheckboxes).some(cb => cb.checked);
                if (updatePricesBtn) {
                    updatePricesBtn.disabled = !anyChecked;
                }
            }

            function calculatePriceChange(input) {
                const productId = input.dataset.productId;
                const currentPrice = parseFloat(input.dataset.currentPrice);
                const newPrice = parseFloat(input.value);
                const priceChangeBadge = document.getElementById(`priceChange_${productId}`);

                if (priceChangeBadge && !isNaN(newPrice) && newPrice > 0 && currentPrice > 0) {
                    const difference = newPrice - currentPrice;
                    const percentChange = ((difference / currentPrice) * 100).toFixed(2);
                    
                    let badgeClass = 'price-change-badge ';
                    let icon = '';
                    
                    if (difference > 0) {
                        badgeClass += 'increase';
                        icon = '↑ ';
                    } else if (difference < 0) {
                        badgeClass += 'decrease';
                        icon = '↓ ';
                    } else {
                        badgeClass += 'no-change';
                        icon = '= ';
                    }
                    
                    priceChangeBadge.className = badgeClass;
                    priceChangeBadge.textContent = `${icon}${Math.abs(percentChange)}%`;
                } else if (priceChangeBadge) {
                    priceChangeBadge.textContent = '--';
                    priceChangeBadge.className = 'price-change-badge';
                }
            }

            // Function to refresh dispenser statuses
            async function refreshDispenserStatuses() {
                try {
                    const response = await fetch('/Product/GetDispenserStatuses');
                    const result = await response.json();
                    
                    if (result.success && result.hasPriceUpdateLogs) {
                        const statusTableBody = document.getElementById('statusTableBody');
                        if (statusTableBody) {
                            let html = '';
                            result.dispenserStatuses.forEach(dispenser => {
                                if (dispenser.hasUpdateLog) {
                                    const statusClass = dispenser.isOnline ? 'status-online' : 'status-offline';
                                    const statusIcon = dispenser.isOnline ? 'bi-check-circle' : 'bi-x-circle';
                                    const updateStatusClass = dispenser.isErrorOccured ? 'bg-danger' : 'bg-success';
                                    const updateStatusIcon = dispenser.isErrorOccured ? 'bi-x-circle' : 'bi-check-circle';
                                    const updateStatusText = dispenser.isErrorOccured ? 'Failed' : 'Updated';
                                    const lastUpdated = dispenser.lastUpdated ? new Date(dispenser.lastUpdated).toLocaleString('en-US', { 
                                        month: 'short', 
                                        day: 'numeric', 
                                        year: 'numeric', 
                                        hour: 'numeric', 
                                        minute: '2-digit', 
                                        hour12: true 
                                    }) : '--';
                                    
                                    html += `
                                        <tr class="dispenser-status-row">
                                            <td>
                                                <div class="status-indicator ${statusClass}">
                                                    <i class="bi ${statusIcon}"></i>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="dispenser-name">${dispenser.dispenserName}</span>
                                            </td>
                                            <td>
                                                <code class="api-endpoint">${dispenser.apiEndPoint}</code>
                                            </td>
                                            <td>
                                                <span class="badge status-badge ${updateStatusClass}">
                                                    <i class="bi ${updateStatusIcon}"></i> ${updateStatusText}
                                                </span>
                                            </td>
                                            <td>
                                                <span class="text-muted">${lastUpdated}</span>
                                            </td>
                                        </tr>
                                    `;
                                }
                            });
                            statusTableBody.innerHTML = html;
                        }
                    }
                } catch (error) {
                    console.error('Error refreshing dispenser statuses:', error);
                }
            }

            // Update Prices Button Click Handler
            updatePricesBtn?.addEventListener('click', async function() {
                const selectedProducts = [];
                
                productCheckboxes.forEach(checkbox => {
                    if (checkbox.checked) {
                        const productId = parseInt(checkbox.dataset.productId);
                        const priceInput = document.getElementById(`newPrice_${productId}`);
                        const newPrice = parseFloat(priceInput.value);
                        
                        if (!isNaN(newPrice) && newPrice > 0) {
                            selectedProducts.push({
                                productId: productId,
                                newPrice: newPrice
                            });
                        }
                    }
                });

                if (selectedProducts.length === 0) {
                    showToast('error', 'No Products Selected', 'Please select products and enter valid prices before updating.');
                    return;
                }

                // Show loader and disable button
                showLoader();
                updatePricesBtn.disabled = true;

                try {
                    const response = await fetch('/Product/UpdatePrices', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(selectedProducts)
                    });

                    const result = await response.json();

                    if (response.ok && result.success) {
                        // Update current prices instantly
                        selectedProducts.forEach(product => {
                            const currentPriceElement = document.getElementById(`currentPrice_${product.productId}`);
                            if (currentPriceElement) {
                                currentPriceElement.textContent = product.newPrice.toFixed(2);
                            }
                            
                            // Update data-current-price attribute for future calculations
                            const priceInput = document.getElementById(`newPrice_${product.productId}`);
                            if (priceInput) {
                                priceInput.dataset.currentPrice = product.newPrice;
                            }
                        });
                        
                        // Refresh dispenser statuses without reloading page
                        await refreshDispenserStatuses();
                        
                        // Reset form
                        productCheckboxes.forEach(checkbox => {
                            checkbox.checked = false;
                            togglePriceInput(checkbox);
                            updateRowSelection(checkbox);
                        });
                        updateSelectAllState();
                        updateButtonState();
                        
                        // Hide loader and show success toast
                        hideLoader();
                        showToast('success', 'Prices Updated Successfully!', `Successfully updated prices for ${selectedProducts.length} product(s) across all dispensers.`);
                    } else {
                        hideLoader();
                        showToast('error', 'Update Failed', result.message || 'Failed to update prices. Please try again.');
                        updatePricesBtn.disabled = false;
                    }
                } catch (error) {
                    hideLoader();
                    showToast('error', 'Error Occurred', `An error occurred while updating prices: ${error.message}`);
                    updatePricesBtn.disabled = false;
                }
            });

            // Change Password Modal Functionality
            const changePasswordModal = document.getElementById('changePasswordModal');
            const newPasswordInput = document.getElementById('newPassword');
            const confirmPasswordInput = document.getElementById('confirmPassword');
            const savePasswordBtn = document.getElementById('savePasswordBtn');
            const passwordAlert = document.getElementById('passwordAlert');
            const passwordAlertMessage = document.getElementById('passwordAlertMessage');
            const strengthBarFill = document.getElementById('strengthBarFill');
            const strengthLevel = document.getElementById('strengthLevel');

            // Password strength checker
            newPasswordInput?.addEventListener('input', function() {
                const password = this.value;
                const strength = calculatePasswordStrength(password);
                updateStrengthIndicator(strength);
            });

            function calculatePasswordStrength(password) {
                let strength = 0;
                if (password.length >= 6) strength += 25;
                if (password.length >= 10) strength += 25;
                if (/[a-z]/.test(password) && /[A-Z]/.test(password)) strength += 25;
                if (/[0-9]/.test(password)) strength += 15;
                if (/[^a-zA-Z0-9]/.test(password)) strength += 10;
                return Math.min(strength, 100);
            }

            function updateStrengthIndicator(strength) {
                strengthBarFill.style.width = strength + '%';
                
                if (strength < 40) {
                    strengthBarFill.style.backgroundColor = '#dc3545';
                    strengthLevel.textContent = 'Weak';
                    strengthLevel.style.color = '#dc3545';
                } else if (strength < 70) {
                    strengthBarFill.style.backgroundColor = '#ffc107';
                    strengthLevel.textContent = 'Medium';
                    strengthLevel.style.color = '#ffc107';
                } else {
                    strengthBarFill.style.backgroundColor = '#28a745';
                    strengthLevel.textContent = 'Strong';
                    strengthLevel.style.color = '#28a745';
                }
            }

            // Toggle password visibility
            window.togglePasswordVisibility = function(inputId, button) {
                const input = document.getElementById(inputId);
                const icon = button.querySelector('i');
                
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            };

            // Reset modal on close
            changePasswordModal?.addEventListener('hidden.bs.modal', function() {
                document.getElementById('changePasswordForm').reset();
                newPasswordInput.classList.remove('is-invalid', 'is-valid');
                confirmPasswordInput.classList.remove('is-invalid', 'is-valid');
                passwordAlert.classList.add('d-none');
                strengthBarFill.style.width = '0%';
                strengthLevel.textContent = '-';
            });

            // Save Password Button Click Handler
            savePasswordBtn?.addEventListener('click', async function() {
                const newPassword = newPasswordInput.value.trim();
                const confirmPassword = confirmPasswordInput.value.trim();

                // Hide previous alerts
                passwordAlert.classList.add('d-none');
                newPasswordInput.classList.remove('is-invalid');
                confirmPasswordInput.classList.remove('is-invalid');

                // Validation
                if (!newPassword) {
                    newPasswordInput.classList.add('is-invalid');
                    showPasswordAlert('Please enter a new password');
                    return;
                }

                if (newPassword.length < 4) {
                    newPasswordInput.classList.add('is-invalid');
                    showPasswordAlert('Password must be at least 4 characters long');
                    return;
                }

                if (!confirmPassword) {
                    confirmPasswordInput.classList.add('is-invalid');
                    showPasswordAlert('Please confirm your password');
                    return;
                }

                if (newPassword !== confirmPassword) {
                    confirmPasswordInput.classList.add('is-invalid');
                    showPasswordAlert('Passwords do not match. Please make sure both passwords are identical.');
                    return;
                }

                // Show loading state
                const btnText = savePasswordBtn.querySelector('.btn-text');
                const spinner = savePasswordBtn.querySelector('.spinner-border');
                btnText.classList.add('d-none');
                spinner.classList.remove('d-none');
                savePasswordBtn.disabled = true;

                try {
                    const response = await fetch('/Product/ChangePassword', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ newPassword: newPassword })
                    });

                    const result = await response.json();

                    if (response.ok && result.success) {
                        // Close modal
                        const modal = bootstrap.Modal.getInstance(changePasswordModal);
                        modal.hide();

                        // Show success toast
                        showToast('success', 'Password Changed Successfully!', 'Your password has been updated. Use the new password for future access.');
                        
                        // Reset form
                        document.getElementById('changePasswordForm').reset();
                    } else {
                        showPasswordAlert(result.message || 'Failed to change password. Please try again.');
                    }
                } catch (error) {
                    showPasswordAlert('An error occurred while changing password: ' + error.message);
                } finally {
                    // Hide loading state
                    btnText.classList.remove('d-none');
                    spinner.classList.add('d-none');
                    savePasswordBtn.disabled = false;
                }
            });

            function showPasswordAlert(message) {
                passwordAlertMessage.textContent = message;
                passwordAlert.classList.remove('d-none');
            }
        });
    </script>
}
